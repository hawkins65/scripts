{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "Monitors Bundle Tile performance for Solana validators, tracking transactions, packets, and bundles received. Also includes Tile Heartbeat metrics for each server, showing the time elapsed between heartbeats for each kind and kind_id. To use table filters (if added), click the funnel icon next to a column title, then click into the search field to type. Click the funnel icon again to close the filter popup. Select epochs using the 'Epoch' dropdown; all available epochs are listed up to the latest in the data.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Firedancer GitHub",
      "type": "link",
      "url": "https://github.com/firedancer-io/firedancer"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Bundle Tile Metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Transactions/s", "axisPlacement": "auto" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "rate(bundle_transaction_received{instance=~\"$instance\",kind=\"bundle\",epoch=~\"$epoch\"}[5m])",
          "legendFormat": "{{instance}}-{{kind_id}}",
          "refId": "A"
        }
      ],
      "title": "Transactions Received",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Packets/s", "axisPlacement": "auto" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "rate(bundle_packet_received{instance=~\"$instance\",kind=\"bundle\",epoch=~\"$epoch\"}[5m])",
          "legendFormat": "{{instance}}-{{kind_id}}",
          "refId": "A"
        }
      ],
      "title": "Packets Received",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Bundles/s", "axisPlacement": "auto" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "rate(bundle_bundle_received{instance=~\"$instance\",kind=\"bundle\",epoch=~\"$epoch\"}[5m])",
          "legendFormat": "{{instance}}-{{kind_id}}",
          "refId": "A"
        }
      ],
      "title": "Bundles Received",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "panels": [],
      "title": "Tile Heartbeat Metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Time Between Heartbeats (s)", "axisPlacement": "auto" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] },
          "unit": "seconds"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "repeat": "instance",
      "targets": [
        {
          "expr": "delta(tile_heartbeat{instance=\"$instance\", epoch=~\"$epoch\"}[1m])",
          "legendFormat": "{{kind}}-{{kind_id}}",
          "refId": "A"
        }
      ],
      "title": "Tile Heartbeat - $instance",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["solana", "firedancer", "validator", "bundle"],
