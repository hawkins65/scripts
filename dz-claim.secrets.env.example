# dz-claim.sh secrets — TEMPLATE.
#
# Copy this to ~/.config/dz-claim/secrets.env (or set DZ_CLAIM_SECRETS to point
# elsewhere), fill in your own values, and chmod 600:
#
#   mkdir -p ~/.config/dz-claim
#   cp secrets.env.example ~/.config/dz-claim/secrets.env
#   chmod 600 ~/.config/dz-claim/secrets.env
#
# The script sources this file at startup (set -a), so every value below becomes
# a default. Anything left blank/commented falls back to the script's own default.
# NEVER commit the filled-in file — it is git-ignored.

# ── Validator identity (required) ─────────────────────────────────────────
# Public on-chain pubkeys. The script refuses to run if these are empty.
export NODE_ID="YOUR_VALIDATOR_NODE_IDENTITY_PUBKEY"
export REWARDS_TOKEN_OWNER="YOUR_REWARDS_WALLET_PUBKEY"

# Signer keypair path (optional). Defaults to
# /home/<user>/mainnet-staked-identity-<NODE_ID>.json when unset.
#export KEYPAIR="/home/sol/mainnet-staked-identity-${NODE_ID}.json"

# ── RPC Endpoints (optional) ──────────────────────────────────────────────
# Per-epoch amount lookups need an RPC with getTransaction history. The script
# auto-builds a failover pool from any *_RPC_URL vars set here (Helius →
# QuickNode → Alchemy → Triton → public mainnet). Set whichever you have.

# Alchemy
#export ALCHEMY_API_KEY="YOUR_ALCHEMY_API_KEY"
#export ALCHEMY_RPC_URL="https://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"

# QuickNode (repeat with _MAINNET_2 / _MAINNET_3 / _COGENT suffixes as needed)
#export QUICKNODE_API_KEY="YOUR_QUICKNODE_TOKEN"
#export QUICKNODE_RPC_URL="https://YOUR-ENDPOINT.solana-mainnet.quiknode.pro/${QUICKNODE_API_KEY}/"

# Helius
#export HELIUS_API_KEY="YOUR_HELIUS_API_KEY"
#export HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}"

# Triton
#export TRITON_API_KEY="YOUR_TRITON_TOKEN"
#export TRITON_RPC_URL="https://YOUR-ENDPOINT.mainnet.rpcpool.com/${TRITON_API_KEY}"

# ── Discord (optional) ────────────────────────────────────────────────────
# Notifications are disabled if the webhook is empty.
#export DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY"
#export DISCORD_USERNAME="DoubleZero Publisher Rewards Bot"
#export DISCORD_AVATAR_URL="https://example.com/avatar.png"

# ── Amount-lookup RPC override (optional) ─────────────────────────────────
# Force a specific endpoint at the front of the getTransaction lookup queue.
#export RPC_URL_OVERRIDE="$HELIUS_RPC_URL"

# ── doublezero CLI RPC (optional) ─────────────────────────────────────────
# RPC the doublezero-solana CLI submits the configure tx through. Unset = CLI default.
#export SOLANA_URL="$HELIUS_RPC_URL"
